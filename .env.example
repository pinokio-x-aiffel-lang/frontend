# ─────────────────────── API ───────────────────────

# 브라우저가 호출하는 base URL.
# - 직접 연결: http://127.0.0.1:8000 같은 전체 주소
# - 프록시 경유: '' (빈 값) → vite dev 프록시 사용 (아래 PROXY_TARGET 필요)
VITE_API_BASE_URL=http://127.0.0.1:8000

# (선택) dev 프록시 대상 주소. ngrok 무료 플랜은 EventSource가 경고 페이지에
# 막히므로, 이 값을 채우고 VITE_API_BASE_URL을 빈 값으로 두면 프록시가
# 서버측에서 ngrok-skip-browser-warning 헤더를 주입해 SSE까지 동작한다.
# 예: VITE_API_PROXY_TARGET=https://xxxx.ngrok-free.app
VITE_API_PROXY_TARGET=

# true: mock 데이터 사용, false: 실 API 호출
VITE_USE_MOCK=true

# mock 응답 지연 (true=1.5~3s, false=즉시)
VITE_MOCK_DELAY=true

# ─────────────────────── UI ───────────────────────

# 디버그 패널 기본 노출 여부 (URL ?debug=1로 즉석 토글 가능)
# 공개 전에 false로 설정
VITE_SHOW_DEBUG=false
